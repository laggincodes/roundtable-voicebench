# VoiceBench Environment Configuration Template
# Copy this file to .env and configure your credentials.
# The .env file is excluded from Git by .gitignore.

# ==============================================================================
# ElevenLabs Conversational AI Credentials (Optional)
# Required only for live evaluation runs against ElevenLabs agents.
# All offline tests and mock targets run with zero credentials.
# ==============================================================================
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here
ELEVENLABS_CONVERSATION_ID=your_elevenlabs_conversation_id_here

# ==============================================================================
# Multi-Agent Roundtable Configuration (Gate 2)
# Specify distinct agent IDs for each roundtable participant role.
# If distinct agents are not configured, VoiceBench will report BLOCKED status.
# ==============================================================================
ELEVENLABS_AGENT_ID_MODERATOR=your_moderator_agent_id_here
ELEVENLABS_AGENT_ID_EXPERT_A=your_expert_a_agent_id_here
ELEVENLABS_AGENT_ID_EXPERT_B=your_expert_b_agent_id_here
